# Development router access for container work.
#
# Copy this file to .env and fill in real values:
#
#     cp .env.example .env && chmod 600 .env
#     # or: python3 tools/dev_router.py init
#
# .env is gitignored. Never commit real credentials.
# This is for a DEVELOPMENT router only -- these are full admin credentials.
#
# This file is the ONLY source of router credentials. Process environment
# variables are deliberately ignored, so a value lives in exactly one place and
# editing this file takes effect on the next command -- there is no second source
# where a stale router address can hide and silently aim a tool elsewhere.
#
# Both tools read these keys from here: tools/dev_router.py and cp.use_rest().
# No export step is needed. To override a value for one call, pass it explicitly
# in code, e.g. cp.use_rest(host='192.168.0.9', password=pw).

# Router LAN address or hostname. No scheme, no trailing slash.
NCOS_DEV_HOST=192.168.0.1

# Admin username. 'admin' on a factory-default router.
NCOS_DEV_USERNAME=admin

# Admin password. On current NCOS this defaults to the device serial number.
# Quotes are optional; if present, one matching outer pair is stripped. A '#'
# inside the value is kept, so passwords containing '#' are safe unquoted.
NCOS_DEV_PASSWORD=

# auto (try https then http), https, or http.
# 'auto' suits a dev router whose admin scheme you have not pinned down.
NCOS_DEV_SCHEME=auto

# TLS certificate verification. Routers ship a self-signed certificate, so this
# is false by default and the connection is encrypted but not authenticated --
# fine on a trusted dev LAN, not fine over the internet. Set true if you have
# installed a certificate that actually validates.
NCOS_DEV_VERIFY_TLS=false

# Per-request timeout in seconds.
NCOS_DEV_TIMEOUT=10
